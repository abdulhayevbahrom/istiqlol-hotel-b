MONGO_URI=mongodb://127.0.0.1:27017/istiqlol
JWT_SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Tashkent

# Booking.com Connectivity API (token-based machine account)
BOOKING_SYNC_ENABLED=false
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=
BOOKING_HOTEL_ID=

# Booking.com room type ID -> dasturdagi Room.category
# Bir qatordagi JSON ko'rinishida yozing.
BOOKING_ROOM_TYPE_MAP={"801185502":"standart","801185503":"lyuks"}

# Booking tavsiyasiga ko'ra 20 sekunddan tez so'rov yuborilmaydi.
BOOKING_POLL_INTERVAL_MS=20000
BOOKING_REQUEST_TIMEOUT_MS=15000

# Faqat nomlar mutlaqo bir xil bo'lsa vaqtinchalik fallback sifatida yoqing.
BOOKING_ALLOW_NAME_FALLBACK=false

# Narx importi standart holatda o'chiq: valyuta konvertatsiyasiz moliyaga
# noto'g'ri summa yozilmasligi uchun. Yoqilsa faqat LOCAL_CURRENCY mos keladi.
BOOKING_IMPORT_PRICES=false
BOOKING_LOCAL_CURRENCY=UZS
